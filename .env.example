# 环境变量配置示例
# 复制此文件为 .env 并填入你的实际凭证

# 火山引擎 Access Key（必需）
VOLCENGINE_AK=your-access-key-here

# 火山引擎 Secret Key（必需）
VOLCENGINE_SK=your-secret-key-here

# 火山引擎 Security Token（可选，用于临时凭证）
# VOLCENGINE_TOKEN=your-security-token-here

# 调试模式（可选）
DEBUG=false

# 默认输出目录（可选）
OUTPUT_DIR=./output

# API 超时时间（可选，单位：毫秒）
API_TIMEOUT=30000

# 最大重试次数（可选）
MAX_RETRIES=3

# 重试延迟基数（可选，单位：毫秒）
RETRY_DELAY=1000
